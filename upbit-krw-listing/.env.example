# Open API Upbit: chỉ để nhận thông báo listing. Không phải private key ví.
# Không cần quyền đặt lệnh, không bật quyền rút tiền. Thêm IP máy này vào API key.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Hai ví khác nhau. ERC dùng cho Ethereum, BNB Chain, Base, Arbitrum, Optimism, Polygon.
# Solana là ví riêng. EVM: hex 32 byte. Solana: base58 64 byte hoặc mảng JSON.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# Số lượng riêng từng chain. Để trống chain không mua. Mỗi ô lớn hơn 0 và tối đa 5.
AMOUNT_ETHEREUM=0.02
AMOUNT_BSC=0.1
AMOUNT_BASE=
AMOUNT_ARBITRUM=
AMOUNT_OPTIMISM=
AMOUNT_POLYGON=
AMOUNT_SOLANA=0.5

# 2 = gas gấp đôi phí hiện tại. Tối đa 20.
GAS_MULTIPLE=2

# Trượt giá, từ 1 đến 50.
SLIPPAGE_PERCENT=10

# FDV tối đa tính bằng USD. Để trống nếu không giới hạn.
MAX_FDV_USD=

# Bot https://t.me/follow07_bot — token lấy từ BotFather, chat id lấy trên giao diện.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# false = chỉ báo kế hoạch, không ký giao dịch.
LIVE=false

# Tuỳ chọn. Dán link thông báo. Tool chỉ mua nếu tin còn trong 3 phút.
NOTICE_URL=

# Tuỳ chọn. Bỏ trống thì dùng RPC công cộng.
# RPC_ETHEREUM=
# RPC_BSC=
# RPC_BASE=
# RPC_ARBITRUM=
# RPC_OPTIMISM=
# RPC_POLYGON=
# RPC_SOLANA=
# JUPITER_API_KEY=
