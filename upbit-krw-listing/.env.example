# Open API Upbit: chỉ để nhận thông báo listing. Không phải private key ví.
# Không cần quyền đặt lệnh, không bật quyền rút tiền. Thêm IP máy này vào API key.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Private key ký giao dịch DEX. Điền ví đúng mạng trong thông báo.
# EVM: hex 32 byte. Solana: base58 64 byte hoặc mảng JSON.
EVM_PRIVATE_KEY=
SOLANA_PRIVATE_KEY=

# Số đồng native mỗi coin (ETH, BNB, SOL hoặc POL). Lớn hơn 0, tối đa 5.
BUY_AMOUNT=0.05

# 2 = gas gấp đôi phí hiện tại. Tối đa 20.
GAS_MULTIPLE=2

# Trượt giá, từ 1 đến 50.
SLIPPAGE_PERCENT=10

# Bot https://t.me/follow07_bot — token lấy từ BotFather, chat id lấy trên giao diện.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# false = chỉ báo kế hoạch, không ký giao dịch.
LIVE=false

# Tuỳ chọn. Dán link thông báo. Tool chỉ mua nếu tin còn trong 3 phút.
NOTICE_URL=

# Tuỳ chọn. Bỏ trống thì dùng RPC công cộng.
# RPC_ETHEREUM=
# RPC_BSC=
# RPC_BASE=
# RPC_ARBITRUM=
# RPC_OPTIMISM=
# RPC_POLYGON=
# RPC_SOLANA=
# JUPITER_API_KEY=
