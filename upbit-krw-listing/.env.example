# Open API Upbit: Access Key + Secret Key. Không phải private key ví.
# Bật quyền đặt lệnh. Không bật quyền rút tiền. Thêm IP máy này vào API key.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# Số KRW dùng cho mỗi coin listing mới có cặp KRW. Tối thiểu 5000.
BUY_KRW=100000

# 2 = giá trần lệnh giới hạn gấp đôi giá trong thông báo.
# Upbit không có gas. Ô này là hệ số giá.
PRICE_MULTIPLE=2

# Bot https://t.me/follow07_bot — token lấy từ BotFather, chat id lấy trên giao diện.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# false = chỉ canh và báo lệnh dự kiến, không gửi lệnh.
LIVE=false

# Tuỳ chọn. Dán link thông báo để canh đúng tin đó nếu nó vẫn chưa tới giờ mua.
NOTICE_URL=
