# Ví riêng, chỉ nạp số BNB/ETH chấp nhận mất. Không commit file .env.
PRIVATE_KEY=

# Để trống thì dùng RPC mặc định của chain trong src/settings.js
RPC_URL=

# bsc | eth | base | robinhood. Để trống thì dùng CHAIN trong src/settings.js.
# Có thể ghi đè lúc chạy: node src/index.js --chain robinhood https://x.com/ten_du_an
CHAIN=

# true = không gửi giao dịch. Đặt false khi muốn mua thật.
# Ngưỡng tax, gas, số lượng mua chỉnh trong src/settings.js, không chỉnh ở đây.
DRY_RUN=true

# --- Solana: npm run copy -- <địa chỉ ví cần theo dõi> ---
# Secret key base58 (Phantom) hoặc mảng JSON 64 số (solana-keygen). Ví riêng, chỉ nạp số SOL chấp nhận mất.
SOLANA_PRIVATE_KEY=
# Để trống thì dùng RPC công cộng. Điền key Helius để nghe transactionSubscribe sớm hơn.
HELIUS_API_KEY=
# Tùy chọn. Jupiter vẫn trả lời khi để trống, key riêng nâng hạn mức.
JUPITER_API_KEY=
# Tùy chọn. Ghi đè RPC/WebSocket nếu không dùng Helius.
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Tùy chọn, chỉ khi tài khoản Jito của bạn có UUID.
JITO_UUID=
