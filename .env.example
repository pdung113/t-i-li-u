# Ví riêng, chỉ nạp số BNB/ETH chấp nhận mất. Không commit file .env.
PRIVATE_KEY=

# Để trống thì dùng RPC mặc định của chain trong src/settings.js
RPC_URL=

# bsc | eth | base | robinhood. Để trống thì dùng CHAIN trong src/settings.js.
# Có thể ghi đè lúc chạy: node src/index.js --chain robinhood https://x.com/ten_du_an
CHAIN=

# true = không gửi giao dịch. Đặt false khi muốn mua thật.
# Ngưỡng tax, gas, số lượng mua chỉnh trong src/settings.js, không chỉnh ở đây.
DRY_RUN=true

# Báo Telegram khi một tài khoản X công khai follow người mới.
# Tạo bot bằng @BotFather, nhắn Start cho bot, rồi lấy chat id từ getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Số mili giây giữa hai lần hỏi danh sách follow. Tối thiểu 1000.
FOLLOW_POLL_MS=3000
