# Tạo bot bằng @BotFather, rồi nhắn /start cho bot.
# Chat id: nhắn bot, mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Báo khi chênh lệch thực tế (đã tính bid/ask nếu có) đạt mức này.
SPREAD_THRESHOLD_PCT=5

# Bỏ pool DEX quá mỏng và cặp CEX gần như không có khối lượng.
MIN_DEX_LIQUIDITY_USD=25000
MIN_CEX_QUOTE_VOLUME_USD=10000
# Binance dùng độ sâu đầu sổ lệnh vì ticker giá không có volume.
MIN_TOP_NOTIONAL_USD=200

# Chênh trên mức này thường là sai token hoặc pool hỏng.
MAX_SPREAD_PCT=80

# Coin đã báo thì không báo lại, trừ khi lệch tăng thêm hơn SPREAD_THRESHOLD_PCT so với lần báo trước.
# Hai dòng dưới không còn dùng để gửi lại tin cũ.
ALERT_COOLDOWN_SEC=900
REALERT_STEP_PCT=2
MAX_ALERTS_PER_SCAN=20

# Hợp đồng nạp/rút đổi chậm; giá được làm mới liên tục trong mỗi vòng quét.
UNIVERSE_REFRESH_SEC=600

# DexScreener cho phép khoảng 300 request/phút. 4.5/s là mức nhanh mà vẫn còn chỗ khi bị 429.
DEX_REQUESTS_PER_SEC=4.5
DEX_BATCH_SIZE=30

# Cặp so với USDT trước, không có thì USDC.
QUOTES=USDT,USDC

# Để trống CHAINS = mọi chain đã map. Thu hẹp nếu muốn mỗi vòng ngắn hơn.
# CHAINS=ethereum,bsc,solana,base,arbitrum,optimism,polygon,avalanche
CHAINS=

EXCHANGES=binance,gate,kucoin,bitget,htx,mexc,okx,bybit

SEND_STARTUP_MESSAGE=true
