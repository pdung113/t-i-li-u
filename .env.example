# Ví riêng, chỉ nạp số BNB/ETH chấp nhận mất. Không commit file .env.
PRIVATE_KEY=

# Để trống thì dùng RPC mặc định của chain trong src/settings.js
RPC_URL=

# bsc | eth | base | robinhood. Để trống thì dùng CHAIN trong src/settings.js.
# Có thể ghi đè lúc chạy: node src/index.js --chain robinhood https://x.com/ten_du_an
CHAIN=

# true = không gửi giao dịch. Đặt false khi muốn mua thật.
# Ngưỡng tax, gas, số lượng mua token chỉnh trong src/settings.js, không chỉnh ở đây.
# Gas và số lượng NFT chỉnh trong src/nft/settings.js, hoặc --gas và --qty lúc chạy.
DRY_RUN=true

# Chỉ cần khi mint/mua qua link collection OpenSea. Mint từ link có sẵn 0x thì không cần.
OPENSEA_API_KEY=
